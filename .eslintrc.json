{
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "strict": ["error", "global"],
    "no-unused-vars": "warn",
    "eqeqeq": "error"
  }
}
